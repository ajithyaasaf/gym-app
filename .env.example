# Database Connection URL (Neon PostgreSQL pooled or direct connection string)
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# 32+ character random hex or base64 string for cookie signing and session integrity
SESSION_SECRET=replace_with_a_secure_random_32_byte_secret_for_production

# Application Base URL
APP_URL=http://localhost:3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Storage Driver: 'local' (development/testing) or 'vercel_blob' / 's3' (production)
STORAGE_DRIVER=local

# Local upload directory when STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Optional S3-compatible configuration if using S3 adapter
# S3_BUCKET=gym-attachments
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

